{
  "name": "napplet",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "turbo run build",
    "dev:site": "node scripts/dev-site.mjs",
    "refresh:protocol": "node scripts/generate-protocol.mjs",
    "generate:protocol": "pnpm refresh:protocol && pnpm --filter \"@napplet/web...\" build",
    "test:protocol": "node --test scripts/generate-protocol.test.mjs",
    "refresh:nap-maturity": "node scripts/refresh-nap-maturity.mjs",
    "test:nap-maturity": "node --test scripts/refresh-nap-maturity.test.mjs",
    "test:showcase-refresh": "node --test scripts/refresh-showcase-apps.test.mjs",
    "test": "pnpm check:jsr && pnpm test:protocol && pnpm test:nap-maturity && pnpm test:showcase-refresh && pnpm test:release-tooling && pnpm test:skills-contracts && pnpm test:agent-output && turbo run test:unit && pnpm test:tutorial",
    "test:unit": "turbo run test:unit",
    "test:tutorial": "node --test scripts/tutorial-package-versions.test.mjs && node scripts/test-tutorial.mjs",
    "test:release-tooling": "node --test scripts/sync-jsr-versions.test.mjs scripts/sync-tutorial-package-versions.test.mjs scripts/jsr-workspace-membership.test.mjs",
    "test:e2e": "turbo run test:e2e",
    "test:installers": "node scripts/test-install-napplet-cli.mjs",
    "test:onboarding-contracts": "node --test scripts/onboarding-contracts.test.mjs",
    "test:skills-contracts": "node --test scripts/skills-contracts.test.mjs",
    "test:spa-onboarding": "node scripts/check-spa-onboarding.mjs",
    "test:workflow-contracts": "node --test scripts/workflow-contracts.test.mjs scripts/conformance-cache.test.mjs scripts/dev-site.test.mjs scripts/web-fixture-workspace.test.mjs",
    "test:convention-contracts": "node --test scripts/test-convention-contracts.test.mjs && node scripts/test-convention-contracts.mjs",
    "test:conformance": "node packages/conformance-cli/dist/cli.js tests/fixtures/napplets/conformant",
    "type-check": "turbo run type-check",
    "check:links": "node scripts/check-links.mjs",
    "check:jsr": "node scripts/check-jsr-exports.mjs",
    "version-packages": "changeset version && node scripts/sync-jsr-versions.mjs && node scripts/sync-tutorial-package-versions.mjs",
    "publish-packages": "turbo run build && pnpm -r --filter='!@napplet/cli' publish --access public --no-git-checks",
    "publish-jsr": "node scripts/sync-jsr-versions.mjs && pnpm -r --filter='./packages/*' --filter='!@napplet/boilerplate' --filter='!@napplet/conformance-cli' exec npx jsr publish --allow-slow-types --allow-dirty",
    "build:edge": "esbuild edge/bunny-middleware.mjs --bundle --format=esm --platform=neutral --conditions=deno --main-fields=module,main --outfile=edge/dist/bunny-middleware.js",
    "test:agent-output": "node --test scripts/agent-markdown.test.mjs scripts/assemble-site.test.mjs",
    "check:markdown-negotiation": "node scripts/check-markdown-negotiation.mjs"
  },
  "devDependencies": {
    "@bunny.net/edgescript-sdk": "0.13.0",
    "@changesets/cli": "^3.0.3",
    "@types/node": "^22.15.0",
    "esbuild": "^0.28.1",
    "happy-dom": "^21.0.4",
    "linkedom": "^0.18",
    "playwright": "^1.59.1",
    "turbo": "^2.9.14",
    "turndown": "^7",
    "turndown-plugin-gfm": "^1",
    "typescript": "^5.9.3",
    "vite": "^6.4.5",
    "vitest": "^4.1.12"
  },
  "packageManager": "pnpm@10.8.0"
}
