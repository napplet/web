{
  "name": "@napplet/archetypes-indexer",
  "version": "0.0.0",
  "private": true,
  "description": "Relay-scoring crawler and SQLite event store that feeds the archetypes.napplet.run static build.",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node src/main.ts",
    "once": "node src/main.ts --once",
    "type-check": "tsc --noEmit",
    "test:unit": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "nostr-tools": "^2.23.3",
    "yaml": "^2.8.3"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/ws": "^8.18.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.12",
    "ws": "^8.21.0",
    "@vitest/coverage-v8": "^4.1.12"
  }
}
