---
interface Props {
  title?: string;
  description?: string;
}
const {
  title = 'napplet — small apps, a growing Nostr ecosystem',
  description = 'Try curated Nostr applets, explore shells, and find the tools to build your own. Small, sandboxed apps connected by the NIP-5D protocol proposal.',
} = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const image = new URL('/og.png', Astro.site);
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#120820" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="napplet" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={image} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="napplet — Small apps. Shared possibilities." />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image} />
    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org', '@type': 'WebSite',
      name: 'napplet', url: 'https://napplet.run/', description,
      sameAs: ['https://github.com/napplet/web', 'https://github.com/napplet/naps'],
    }).replace(/</g, '\\u003c')} />
  </head>
  <body><slot /></body>
</html>
