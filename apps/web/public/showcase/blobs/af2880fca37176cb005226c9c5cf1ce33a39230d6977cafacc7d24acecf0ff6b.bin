eam);margin-left:4px;font-size:11px}.lock-box{pointer-events:none;filter:drop-shadow(0 1px 2px #182030);width:40px;height:40px;position:absolute;transform:translate(-50%,-50%)}.lock-box:before{content:"";border:2px solid var(--accent);clip-path:polygon(0 0,35% 0,35% 3px,65% 3px,65% 0,100% 0,100% 35%,calc(100% - 3px) 35%,calc(100% - 3px) 65%,100% 65%,100% 100%,65% 100%,65% calc(100% - 3px),35% calc(100% - 3px),35% 100%,0 100%,0 65%,3px 65%,3px 35%,0 35%);border-radius:4px;position:absolute;inset:0}.lock-box span{color:var(--accent);letter-spacing:.1em;font-size:10px;font-weight:800;position:absolute;bottom:100%;left:50%;transform:translate(-50%,-2px)}.lock-box.waiting{opacity:.45}.lock-box.waiting span{display:none}.indicator.rocket .indicator-label{border-radius:4px}@container (width<=300px) or (height<=240px){.incoming{padding:3px 8px;font-size:12px}.incoming small{display:none}}@media (prefers-reduced-motion:reduce){.incoming{animation:none}}.reticle,.aim-point{pointer-events:none;filter:drop-shadow(0 1px 2px #182030);position:absolute;transform:translate(-50%,-50%)}.reticle{opacity:.85;border:1px solid #fff1d2;border-radius:50%;width:22px;height:22px;top:50%;left:50%}.reticle-dot{background:#fff1d2;width:2px;height:2px;position:absolute;top:9px;left:9px}.reticle.assisted{opacity:1;border:2px solid #a9f5ce}.aim-point{border:2px solid #a9f5ce;border-radius:2px;width:10px;height:10px}.flight-path{pointer-events:none;filter:drop-shadow(0 1px 2px #182030);opacity:.8;border:2px solid #fff1d2;border-radius:50%;width:10px;height:10px;position:absolute;transform:translate(-50%,-50%)}.flight-path:before,.flight-path:after{content:"";background:currentColor;width:8px;height:2px;position:absolute;top:2px}.flight-path{color:#fff1d2}.flight-path:before{margin-right:2px;right:100%}.flight-path:after{margin-left:2px;left:100%}.flight-path.impact{color:#ffb547;opacity:1;border-color:#ffb547}.hit-marker{position:absolute;inset:-10px}.hit-marker:before,.hit-marker:after{content:"";background:#fff1d2;width:2px;height:100%;position:absolute;top:0;left:50%;transform:rotate(45deg)}.hit-marker:after{transform:rotate(-45deg)}.hit-marker.armored{opacity:.65;border:1px dashed #fff1d2;border-radius:50%}.hit-marker.armored:before,.hit-marker.armored:after{display:none}.perf{z-index:50;color:#b6f5a8;pointer-events:none;background:#0009;border-radius:6px;margin:0;padding:6px 8px;font:11px/1.35 ui-monospace,monospace;position:absolute;top:8px;left:8px}
/*$vite$:1*/</style>
  </head>
  <body>
    <main id="app" class="app">
      <canvas id="scene" class="scene" tabindex="-1" aria-label="Flight view"></canvas>

      <div id="views" class="views"></div>
      <div id="spareView" class="spare" hidden>
        <p>Connect another controller; press a button if it is not detected</p>
      </div>

      <template id="viewTemplate">
        <section class="view">
          <div class="hud">
            <div class="gauges">
              <div class="chip chip-pilot" data-ref="pilot" hidden>
                <span class="chip-label">Pilot</span>
                <span class="chip-value" data-ref="pilotName">P1</span>
              </div>
              <div class="chip">
                <span class="chip-label">Speed</span>
                <span class="chip-value"><span data-ref="speed">0</span><small>km/h</small></span>
              </div>
              <div class="chip">
                <span class="chip-label">Alt</span>
                <span class="chip-value"><span data-ref="alt">0</span><small>m</small></span>
              </div>
            </div>
            <span class="beginner-label" data-ref="beginner" hidden>Beginner</span>
            <div class="meters">
              <div class="meter" aria-label="Throttle">
                <span class="chip-label">Thr</span>
                <span class="meter-track"><span data-ref="throttle" class="meter-fill meter-throttle"></span></span>
              </div>
              <div class="meter" aria-label="Boost">
                <span class="chip-label">Boost</span>
                <span class="meter-track"><span data-ref="boost" class="meter-fill meter-boost"></span></span>
              </div>
              <div class="meter" data-ref="rocketMeter" aria-label="Rockets ready: 2">
                <span class="chip-label">Rkt</span>
                <span class="rocket-pips">
                  <span class="rocket-pip"><span class="rocket-fill" data-ref="rocketPip"></span></span>
                  <span class="rocket-pip"><span class="rocket-fill" data-ref="rocketPip"></span></span>
                </span>
              </div>
            </div>
            <div data-ref="stall" class="stall" role="status" hidden>
              <span class="stall-icon" aria-hidden="true">▲</span> STALL <small>nose down</small>
            </div>
            <div data-ref="incoming" class="incoming" role="status" hidden>
              <span class="stall-icon" aria-hidden="true">◆</span> ROCKET LOCK <small>bank hard!</small>
            </div>
          </div>
          <div class="reticle" data-ref="reticle" aria-label="Gun sight" hidden>
            <span class="reticle-dot"></span><span class="hit-marker" data-ref="hitMarker" hidden></span>
          </div>
          <div class="aim-point" data-ref="aimPoint" aria-label="Predicted assisted shot" hidden></div>
          <div class="flight-path" data-ref="flightPath" aria-label="Flight path" hidden></div>
          <div class="lock-box" data-ref="lockBox" aria-label="Rocket seeker has a target" hidden><span>LOCK</span></div>
          <div class="indicators" data-ref="indicators" aria-hidden="true"></div>
          <div data-ref="crash" class="crash" role="status" hidden>
            <p class="crash-title" data-ref="crashTitle">Crashed!</p>
            <p class="crash-sub">Back in the air in <span data-ref="respawn">5</span></p>
          </div>
          <div class="beginner-offer" data-ref="offer" hidden role="group" aria-label="Easier flight controls">
            <p>Want easier controls? Beginner mode handles throttle. Up climbs, down dives; left/right rolls and turns.</p>
            <button type="button" data-ref="accept">Try beginner mode (A)</button>
            <button type="button" data-ref="decline">Keep current controls (B)</button>
          </div>
        </section>
      </template>

      <div id="touchControls" class="touch" aria-hidden="true">
        <div id="stick" class="stick"><div id="stickKnob" class="stick-knob"></div></div>
        <div class="touch-right">
          <div class="touch-buttons">
            <button id="yawLeft" class="tbtn" type="button" tabindex="-1">◁</button>
            <button id="yawRight" class="tbtn" type="button" tabindex="-1">▷</button>
            <button id="fireButton" class="tbtn tbtn-fire" type="button" tabindex="-1">Fire</button>
            <button id="rocketButton" class="tbtn tbtn-rocket" type="button" tabindex="-1">Rocket</button>
            <button id="boostButton" class="tbtn tbtn-boost" type="button" tabindex="-1">Boost</button>
          </div>
          <div id="throttleSlider" class="throttle">
            <div id="throttleKnob" class="throttle-knob"></div>
          </div>
        </div>
      </div>

      <div class="corner">
        <button id="cameraButton" class="icon-btn" type="button" title="Camera (C)" aria-label="Change camera">◉</button>
        <button id="pauseButton" class="icon-btn" type="button" title="Pause (Esc)" aria-label="Pause">❚❚</button>
      </div>

      <div id="menu" class="menu">
        <div class="card" role="dialog" aria-labelledby="menuTitle">
          <section class="card-brief">
            <h2 id="menuTitle" class="card-title">Ready for take-off</h2>
            <p class="card-sub" id="menuSub">Fly anywhere around the little planet. Keep your speed up — slow too much and the wings stall.</p>
            <p class="card-sub card-goal">Plug in more controllers to dogfight friends: shoot their wings and tail with guns and rockets, and shake off what they fire back.</p>
            <div class="card-options" role="group" aria-label="Game options">
              <div id="flightModes" class="flight-modes"></div>
              <p class="hint" id="modeHint">Beginner: stick up climbs, down dives; left/right rolls and turns. Full maneuvering speed; release to level out. Gamepad: LB switches mode, A flies.</p>
              <div class="toggles">
                <label class="toggle"><input id="invertToggle" type="checkbox" /> Invert normal pitch</label>
                <label class="toggle"><input id="muteToggle" type="checkbox" /> Mute</label>
              </div>
            </div>
            <button id="flyButton" class="fly-btn" type="button">Fly</button>
            <p class="hint" id="startHint">or press a key / gamepad A</p>
            <p class="pilots" id="pilotsNote">Up to 4 pilots: each extra controller joins in split screen.</p>
            <p class="save-note" id="saveNote" hidden></p>
          </section>
          <section class="card-setup" aria-label="Controls">
            <div class="controls" id="controlsPanel" data-device="keyboard">
              <h3 class="controls-title">Controls <span class="controls-device" id="controlsDevice">Keyboard</span></h3>
              <dl class="controls-list" data-for="keyboard">
                <dt>Pitch / roll</dt><dd>W S A D · arrows</dd>
                <dt>Rudder</dt><dd>Q E</dd>
                <dt>Throttle</dt><dd>T / Shift up · G down</dd>
                <dt>Boost</dt><dd>Space</dd>
                <dt>Guns</dt><dd>F / Enter</dd>
                <dt>Rocket</dt><dd>R</dd>
                <dt>Camera</dt><dd>C</dd>
                <dt>Pause</dt><dd>Esc / P</dd>
                <dt>Sound</dt><dd>M</dd>
              </dl>
              <dl class="controls-list" data-for="gamepad" hidden>
                <dt>Pitch / roll</dt><dd>Left stick · D-pad</dd>
                <dt>Rudder</dt><dd>LT / RT · right stick</dd>
                <dt>Throttle</dt><dd>RB up · LB down</dd>
                <dt>Boost</dt><dd>A</dd>
                <dt>Guns</dt><dd>B</dd>
                <dt>Rocket</dt><dd>Y</dd>
                <dt>Camera</dt><dd>X</dd>
                <dt>Pause</dt><dd>Start</dd>
                <dt>Beginner mode</dt><dd>LB in this menu</dd>
                <dt>Pilots</dt><dd>Connect another controller to join (up to 4)</dd>
              </dl>
              <p class="hint" id="flightHint">Stick back / S pulls the nose up. Stalled? Push the nose down and add power.</p>
              <p class="hint">Holed wings pull the plane toward them and a shot-up tail drops the nose. Lose a whole wing or the tail and you're going down.</p>
              <p class="hint">Rockets lock onto a plane just ahead of their nose. Two on the wings, one reloads every 8 seconds; two hits on a part bring a plane down. Locked on? Bank hard and pull to shake it. A rocket that misses keeps flying round the planet.</p>
            </div>
          </section>
        </div>
      </div>

      <div id="errorNotice" class="error" hidden>
        <p>Poly Dogfight needs WebGL to draw the planet, and it isn't available here.</p>
      </div>
    </main>
  </body>
</html>
