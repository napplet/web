-cream);pointer-events:none;border-radius:50%;width:42%;height:42%;box-shadow:0 3px #18203059}.touch-right{align-items:flex-end;gap:12px;display:flex}.touch-buttons{grid-template-columns:52px 52px;gap:10px;display:grid}.tbtn{pointer-events:auto;touch-action:none;min-width:52px;min-height:52px;color:var(--cream);font:inherit;background:#18203073;border:2px solid #fff6e259;border-radius:16px;font-size:16px}.tbtn-boost{background:var(--boost);min-height:60px;color:var(--ink-solid);grid-column:span 2;font-weight:800}.tbtn-fire{background:var(--danger);color:#fff;font-weight:800}.tbtn-rocket{background:var(--accent);color:var(--ink-solid);letter-spacing:.02em;padding:0;font-size:12px;font-weight:800}.throttle{pointer-events:auto;touch-action:none;background:#18203073;border:2px solid #fff6e259;border-radius:16px;width:52px;height:clamp(110px,30vmin,170px);position:relative}.throttle-knob{background:var(--sky);pointer-events:none;border-radius:10px;height:22px;position:absolute;left:4px;right:4px}.error{background:var(--ink-solid);text-align:center;place-items:center;padding:16px;display:grid;position:absolute;inset:0}@media (width<=420px),(height<=420px){:root{font-size:13px}}@container (width<=420px) or (height<=420px){.chip{min-width:66px;padding:4px 8px}.chip-value{font-size:17px}.meters{width:140px}}@container (width<=300px) or (height<=240px){.meters,.chip-value small{display:none}.hud{top:4px;left:4px}.chip{min-width:0;padding:2px 6px}.chip-label{font-size:8px}.chip-value{font-size:14px}.stall{padding:3px 8px;font-size:12px}.stall small{display:none}}@media (width<=300px),(height<=240px){.corner #cameraButton{display:none}.corner{top:4px;right:4px}.icon-btn{width:32px;height:32px}.card{padding:10px 12px}.card-title{font-size:16px}.card-sub,.controls,.pilots,.hint{display:none}.fly-btn{min-height:40px;font-size:16px}.toggles,.card-setup{display:none}.card-options{margin-bottom:8px;padding:0 6px}}@media (height<=420px){.stick{width:104px;height:104px}.throttle{height