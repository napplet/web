    <style>:root{--ink: #12131c;--dusk: #2d3147;--sun: #3ddc5a;--cream: #f1f3ff;--warn: #ff5a4f;--green: #3ddc5a;color-scheme:dark;font:14px/1.4 system-ui,-apple-system,Segoe UI,sans-serif}*{box-sizing:border-box}:where(html,body,body *){-webkit-user-select:none;user-select:none;-webkit-touch-callout:none}html,body,#app{height:100%;margin:0}body{background:var(--ink);color:var(--cream);overflow:hidden}.stage{position:relative;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:8px;width:100%;height:100%}.screen{position:relative;flex:none}.game{display:block;width:100%;height:100%;outline:none;touch-action:none}button{font:inherit;cursor:pointer}.corner-buttons{position:absolute;top:6px;right:6px;display:flex;gap:6px}.menu-button{padding:4px 10px;border:2px solid var(--ink);border-radius:6px;background:var(--cream);color:var(--ink);font-weight:700;font-size:12px}.menu{position:absolute;top:0;right:0;bottom:0;left:0;display:grid;place-items:center;padding:8px;background:#1d1724b8;overflow:auto}.menu[hidden]{display:none}.menu-card{width:min(400px,100%);max-height:100%;overflow:auto;padding:14px 18px;border:3px solid var(--ink);border-radius:10px;background:var(--cream);color:var(--ink);box-shadow:0 6px 0 var(--ink)}.menu-title{font-size:26px;font-weight:900;letter-spacing:2px;text-align:center;font-style:italic}.green{padding:0 4px;border-radius:3px;background:var(--ink);color:var(--green)}.menu-result{margin-top:4px;text-align:center;font-weight:700;font-size:16px;color:#b0441e}.menu-result[hidden]{display:none}.how p{margin:8px 0}.keys{margin:8px 0;padding:0;list-style:none;font-size:13px}.keys li{margin:4px 0}kbd{display:inline-block;min-width:20px;padding:0 4px;border:1.5px solid var(--ink);border-bottom-width:3px;border-radius:4px;background:#fff;font:700 11px/16px system-ui,sans-serif;text-align:center}.menu-actions{display:flex;gap:8px;justify-content:center;margin-top:10px}.menu-actions button{min-width:100px;min-height:36px;padding:6px 14px;border:2px solid var(--ink);border-radius:8px;background:#fff;color:var(--ink);font-weight:800}.menu-actions button.primary{background:var(--green)}.menu-actions button[hidden]{display:none}.menu-actions button:focus-visible,.menu-button:focus-visible{outline:3px solid var(--sun);outline-offset:2px}.touch-mode .keys,.touch-keys{display:none}.touch-mode .touch-keys{display:block}.touch{display:flex;justify-content:space-between;align-items:center;width:100%;max-width:900px;padding:0 8px 8px}.touch[hidden]{display:none}.touch-group{display:flex;gap:10px}.touch button{width:64px;height:64px;border:3px solid var(--cream);border-radius:50%;background:#fff4dc26;color:var(--cream);font-size:22px;font-weight:900;touch-action:none}.touch button{width:50px;height:50px;font-size:18px}.touch-group{gap:8px}.touch-grid{display:grid;grid-template-columns:repeat(4,auto);gap:6px;align-items:center;justify-items:center}.touch button.touch-attack{width:50px;height:50px;font-size:16px;border-color:var(--warn);color:var(--warn)}.touch button.held{background:#fff4dc66}.too-small{position:absolute;top:0;right:0;bottom:0;left:0;display:grid;place-items:center;padding:8px;text-align:center;background:var(--ink);color:var(--warn);font-weight:700}.too-small[hidden]{display:none}
</style>
    <meta name="napplet-type" content="stick-brawl">
    <meta name="napplet-config-schema" content="{&quot;$schema&quot;:&quot;http://json-schema.org/draft-07/schema#&quot;,&quot;$version&quot;:1,&quot;type&quot;:&quot;object&quot;,&quot;additionalProperties&quot;:false,&quot;properties&quot;:{&quot;touchButtons&quot;:{&quot;type&quot;:&quot;boolean&quot;,&quot;title&quot;:&quot;Always show touch buttons&quot;,&quot;description&quot;:&quot;Show the on-screen move, jump, roll and attack buttons even when a keyboard is available.&quot;,&quot;default&quot;:false,&quot;x-napplet-section&quot;:&quot;Game&quot;,&quot;x-napplet-order&quot;:1}}}">
  </head>
  <body>
    <main id="app" class="app">
      <div id="stage" class="stage">
        <div id="screen" class="screen">
          <canvas
            id="game"
            class="game"
            tabindex="0"
            aria-label="Stick Brawl. You are the green stickman. Fight off the enemy stickmen."
          ></canvas>
          <div class="corner-buttons">
            <button id="fullscreenButton" class="menu-button fullscreen-toggle" type="button" title="Full screen" hidden>⛶</button>
            <button id="menuButton" class="menu-button" type="button" title="Menu (Esc)" hidden>☰ Menu</button>
          </div>
        </div>

        <div id="touch" class="touch" hidden>
          <div class="touch-group">
            <button id="touchLeft" type="button" aria-label="Move left">◀</button>
            <button id="touchRight" type="button" aria-label="Move right">▶</button>
          </div>
          <div class="touch-grid">
            <button id="touchBlock" type="button" aria-label="Block">🛡</button>
            <button id="touchShoot" type="button" aria-label="Shoot">🔫</button>
            <button id="touchSword" type="button" aria-label="Sword">⚔</button>
            <button id="touchKick" type="button" aria-label="Kick">🦶</button>
            <span></span>
            <button id="touchRoll" type="button" aria-label="Roll">▼</button>
            <button id="touchJump" type="button" aria-label="Jump">▲</button>
            <button id="touchAttack" class="touch-attack" type="button" aria-label="Attack">HIT</button>
          </div>
        </div>

        <div id="menu" class="menu" role="dialog" aria-modal="true" aria-labelledby="menuTitle">
          <div class="menu-card">
            <div id="menuTitle" class="menu-title">STICK BRAWL</div>
            <div class="how">
              <p>You are the <b class="green">green stickman</b>. Enemy stickmen keep coming to get you, and there is no limit to how many! Knock them out before they swarm you!</p>
              <p>The fight is in a <b>5-floor building</b> with 4 rooms on each floor. Every room has <b>doors</b> that smash with one hit (enemies can smash them too). Enemies climb in from the <b>balconies</b> and the <b>street</b>, and use the <b>stairs</b> to find you.</p>
              <p>A <b>fire escape</b> runs from the apartment balconies across to the old <b>warehouse</b> next door. It has crates to jump over and a roof with a water tower.</p>
              <p>Enemies go down after <b>2 hits</b>. Big <b>Brutes</b> take <b>3 hits</b> and punch really fast! Little <b>Runts</b> go down after <b>1½ hits</b> and only do half a hit, but there are lots of them. You can take <b>100 hits</b> before the fight starts over. Watch out: when an enemy pulls his fist back, he's about to punch!</p>
              <ul class="keys">
                <li><kbd>←</kbd> <kbd>→</kbd> move</li>
                <li><kbd>↑</kbd> jump, or climb up the stairs when you see <b>↑</b></li>
                <li><kbd>Space</kbd> punch (press faster to punch faster!)</li>
                <li><kbd>Z</kbd> kick, or <b>drop-kick</b> if you're in the air</li>
                <li>hold <kbd>Ctrl</kbd> block punches from the front</li>
                <li><kbd>Left Alt</kbd> quick-draw your revolver and shoot (one shot per press). Shoot an enemy in the <b>head</b> to knock him out at once!</li>
                <li><kbd>Left Shift</kbd> pull the sword off your back and swing it (worth 1½ hits!)</li>
                <li>tap <kbd>↓</kbd> roll (you can't be hit while rolling), or go down the stairs when you see <b>↓</b></li>
                <li>hold <kbd>↓</kbd> slide along the floor (the faster you run, the farther you go). Punches go over your head, and you can attack while sliding!</li>
                <li><kbd>Esc</kbd> open this menu</li>
                <li>🎮 <b>Controller:</b> stick or D-pad move (tap down to roll, hold to slide), <kbd>A</kbd> jump, <kbd>X</kbd> punch, <kbd>B</kbd> kick, <kbd>Y</kbd> sword, hold <kbd>LB</kbd>/<kbd>LT</kbd> block, <kbd>RB</kbd>/<kbd>RT</kbd> shoot, <kbd>Start</kbd> menu</li>
              </ul>
              <p class="touch-keys">Use <b>◀ ▶</b> to move, <b>▲</b> to jump or climb stairs, tap <b>▼</b> to roll or go down stairs (hold it to slide), hold <b>🛡</b> to block, <b>🔫</b> to shoot, <b>⚔</b> to swing your sword, <b>HIT</b> to punch and <b>🦶</b> to kick (in the air it's a drop-kick).</p>
            </div>
            <div class="menu-actions">
              <button id="playButton" class="primary" type="button">Fight!</button>
              <button id="restartButton" type="button" hidden>Start over</button>
              <button id="menuFullscreenButton" class="fullscreen-toggle" type="button" hidden>⛶ Full screen</button>
            </div>
          </div>
        </div>

        <div id="tooSmall" class="too-small" hidden>Make the window bigger to fight!</div>
      </div>
    </main>
  </body>
</html>
