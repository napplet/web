{
  "name": "@napplet/cli",
  "version": "0.11.0",
  "description": "Standalone CLI for creating, configuring, testing, and deploying napplets",
  "type": "module",
  "files": [
    "src",
    "deno.json",
    "README.md"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "deno task build",
    "type-check": "deno task check",
    "test:unit": "deno task test:unit",
    "compile:linux-x86_64": "deno task compile:linux-x86_64",
    "compile:linux-aarch64": "deno task compile:linux-aarch64",
    "compile:darwin-x86_64": "deno task compile:darwin-x86_64",
    "compile:darwin-aarch64": "deno task compile:darwin-aarch64",
    "compile:windows-x86_64": "deno task compile:windows-x86_64",
    "compile": "deno task compile",
    "compile:pruned": "deno task compile:pruned",
    "compile:bundle": "deno task compile:bundle",
    "compile:minify": "deno task compile:minify",
    "compile:no-code-cache": "deno task compile:no-code-cache",
    "compile:small": "deno task compile:small",
    "compile:quickjs": "deno task compile:quickjs",
    "compile:quickjs-minify": "deno task compile:quickjs-minify",
    "compile:quickjs-pruned": "deno task compile:quickjs-pruned"
  },
  "dependencies": {
    "@napplet/boilerplate": "workspace:^",
    "@scure/base": "^1.2.6",
    "applesauce-relay": "^5.2.0",
    "applesauce-signers": "^5.2.0",
    "fflate": "0.8.2",
    "nostr-tools": "^2.23.3",
    "parse5": "^7.3.0",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@types/node": "^22.15.0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sandwichfarm/napplet.git",
    "directory": "packages/cli"
  },
  "keywords": [
    "nostr",
    "napplet",
    "cli",
    "deno",
    "nip-5d"
  ]
}
