{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "dev": {
      "cache": false,
      "persistent": true
    },
    "build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        "dist/**"
      ]
    },
    "test": {
      "dependsOn": [
        "build"
      ]
    },
    "test:unit": {
      "dependsOn": [
        "build"
      ],
      "outputs": [
        "coverage/**"
      ]
    },
    "test:e2e": {
      "dependsOn": [
        "^build"
      ],
      "cache": false
    },
    "type-check": {
      "dependsOn": [
        "^build"
      ]
    },
    "@napplet/docs#build": {
      "outputs": [
        ".vitepress/dist/**"
      ]
    }
  },
  "globalDependencies": [
    "packages/core/src/nap-catalog.ts",
    "packages/core/src/nap-maturity.ts",
    "scripts/lib/nap-maturity-docs.ts"
  ]
}
